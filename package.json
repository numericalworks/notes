{
  "name": "notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An Apple Notes-inspired Markdown notes app that builds to a single self-contained index.html",
  "scripts": {
    "build": "bun build.ts",
    "build:small": "bun build.ts --no-mermaid",
    "dev": "bun build.ts --serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "asciimath": "^0.0.1",
    "mermaid": "^12.3.0"
  }
}
